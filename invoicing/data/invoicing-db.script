CREATE SCHEMA PUBLIC AUTHORIZATION DBA
CREATE MEMORY TABLE PUBLIC.CATEGORY(OID VARCHAR(36) NOT NULL PRIMARY KEY,DESCRIPTION VARCHAR(50))
CREATE MEMORY TABLE PUBLIC.CUSTOMER(NUMBER INTEGER NOT NULL PRIMARY KEY,NAME VARCHAR(50),CITY VARCHAR(20),STATE VARCHAR(30),STREET VARCHAR(30),ZIPCODE INTEGER)
CREATE MEMORY TABLE PUBLIC.IMAGES(ID VARCHAR(32) NOT NULL PRIMARY KEY,GALLERY VARCHAR(32),IMAGE VARBINARY(16777216))
CREATE MEMORY TABLE PUBLIC.OXDISCUSSIONCOMMENTS(ID VARCHAR(32) NOT NULL PRIMARY KEY,"COMMENT" CLOB(1G),DISCUSSIONID VARCHAR(32),TIME TIMESTAMP,USERNAME VARCHAR(60))
CREATE INDEX IDXBHLX4VUNN24YM1TBRLGQ8G30M ON PUBLIC.OXDISCUSSIONCOMMENTS(DISCUSSIONID)
CREATE MEMORY TABLE PUBLIC.PRODUCT(NUMBER INTEGER NOT NULL PRIMARY KEY,DESCRIPTION VARCHAR(50),CATEGORY_OID VARCHAR(36),PHOTOS VARCHAR(32),PRICE NUMERIC(38,2),REMARKS VARCHAR(255),AUTHOR_OID VARCHAR(36),CONSTRAINT FKH3IAMU1OTF3NEQ0KUUJUGSB0L FOREIGN KEY(CATEGORY_OID) REFERENCES PUBLIC.CATEGORY(OID))
CREATE MEMORY TABLE PUBLIC.AUTHOR(OID VARCHAR(36) NOT NULL PRIMARY KEY,NAME VARCHAR(50))
CREATE MEMORY TABLE PUBLIC.COMMERCIALDOCUMENT(DTYPE VARCHAR(31) NOT NULL,OID VARCHAR(36) NOT NULL PRIMARY KEY,DATE DATE,NUMBER INTEGER,REMARKS VARCHAR(255),YEAR INTEGER,CUSTOMER_NUMBER INTEGER NOT NULL,INVOICE_OID VARCHAR(36),CHECK((PUBLIC.COMMERCIALDOCUMENT.DTYPE) IN (('Invoice'),('Order'))),CHECK((PUBLIC.COMMERCIALDOCUMENT.DTYPE!='Invoice') OR ((PUBLIC.COMMERCIALDOCUMENT.NUMBER IS NOT NULL) AND (PUBLIC.COMMERCIALDOCUMENT.YEAR IS NOT NULL))),CHECK((PUBLIC.COMMERCIALDOCUMENT.DTYPE!='Order') OR ((PUBLIC.COMMERCIALDOCUMENT.NUMBER IS NOT NULL) AND (PUBLIC.COMMERCIALDOCUMENT.YEAR IS NOT NULL))),CONSTRAINT FK56PAQ1B5A5T8THF7WP41NX3AN FOREIGN KEY(CUSTOMER_NUMBER) REFERENCES PUBLIC.CUSTOMER(NUMBER),CONSTRAINT FKS1QJ42TJNRWLW6NA0KCFL922K FOREIGN KEY(INVOICE_OID) REFERENCES PUBLIC.COMMERCIALDOCUMENT(OID))
CREATE MEMORY TABLE PUBLIC.COMMERCIALDOCUMENT_DETAILS(COMMERCIALDOCUMENT_OID VARCHAR(36) NOT NULL,PRODUCT_NUMBER INTEGER NOT NULL,QUANTITY INTEGER,CONSTRAINT FKAO2Y0TUM8JI2FAMU16HCMQQVB FOREIGN KEY(PRODUCT_NUMBER) REFERENCES PUBLIC.PRODUCT(NUMBER),CONSTRAINT FK22XOMR3U13J0X33YVSO2FMMEG FOREIGN KEY(COMMERCIALDOCUMENT_OID) REFERENCES PUBLIC.COMMERCIALDOCUMENT(OID))
ALTER TABLE PUBLIC.PRODUCT ADD CONSTRAINT FKTAFLSTDU5WK59V1XHNK96VDYX FOREIGN KEY(AUTHOR_OID) REFERENCES PUBLIC.AUTHOR(OID)
ALTER SEQUENCE SYSTEM_LOBS.LOB_ID RESTART WITH 1
